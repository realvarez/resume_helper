# Resume Worker configuration — copy this file to `.env` and fill in your keys.
#   cp .env.example .env

# --- LLM Configuration (Provider Agnostic) -----------------------------------
# Any LiteLLM-compatible model string and corresponding API key works.
# Examples:
#   Google Gemini:    LLM_MODEL=gemini/gemini-3.8-flash           (key from aistudio.google.com)
#   OpenRouter:       LLM_MODEL=openrouter/anthropic/claude-sonnet-4.5 (key from openrouter.ai)
#   Groq:             LLM_MODEL=groq/llama-3.3-70b-versatile      (key from console.groq.com)
#   OpenAI:           LLM_MODEL=openai/gpt-4o                     (key from platform.openai.com)
#   Local Ollama:     LLM_MODEL=ollama/llama3.1                   (no key needed)
LLM_MODEL=gemini/gemini-3.8-flash
LLM_API_KEY=your-api-key-here

# Optional: creativity of the writing (0 = deterministic, 1 = creative)
LLM_TEMPERATURE=0.4

# --- Company research (optional but recommended) -----------------------------
# Free tier available at https://tavily.com — enables live web research about
# the company, its interview process and Canadian resume/application norms.
# Without a key the app still works using the model's own knowledge only.
TAVILY_API_KEY=tvly-...

# --- Tuning (optional) -------------------------------------------------------
REQUEST_TIMEOUT=300
